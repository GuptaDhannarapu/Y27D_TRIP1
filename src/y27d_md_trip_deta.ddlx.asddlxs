@Metadata.layer: #CORE

@UI.lineItem: [{criticality: 'Status_msg'}]
@UI:{
        headerInfo:{

        typeName: 'Trip Plan',
        typeNamePlural: 'Trip Plans',
        title: { value: 'Batch_Id' }
     } }

annotate entity Y27D_C_TRIP_PLAN with
{

  @UI.facet: [
              { id: 'Collection',
                    purpose: #STANDARD,
                    type: #COLLECTION,
                    label: 'Plan Details',
                    position: 1
                    },
//              {
//                purpose: #STANDARD,
//                type: #IDENTIFICATION_REFERENCE,
//                label: 'Itineary',
//                parentId: 'Collection',
//                position: 10 },
              { 
                purpose: #STANDARD,
                type: #FIELDGROUP_REFERENCE,
                label: 'Itineary',
                parentId: 'Collection',
                position: 10,
                targetQualifier: 'FG1' 
                },
              { 
                purpose: #STANDARD,
                type: #FIELDGROUP_REFERENCE,
                label: 'Finance',
                parentId: 'Collection',
                position: 20,
                targetQualifier: 'FG2' 
                },
                 { 
                purpose: #STANDARD,
                type: #FIELDGROUP_REFERENCE,
                label: 'Personal Info',
                parentId: 'Collection',
                position: 30,
                targetQualifier: 'FG3' 
                },

              { id: 'Trip_pax',
                purpose: #STANDARD,
                type: #LINEITEM_REFERENCE,
                label: 'Pax Details',
                position: 2,
                targetElement: '_paxDet' },

               { id: 'Trip_Act',
                purpose: #STANDARD,
                type: #LINEITEM_REFERENCE,
                label: 'Activities',
                position: 3,
                targetElement: '_plaAct' },

                { id:'idHFPlace',
                position: 10,
                     purpose: #HEADER,
                     type: #DATAPOINT_REFERENCE,
                     targetQualifier: 'Place'
                      },
                { id:'idHFComment',
                  position: 20,
                     purpose: #HEADER,
                     type: #DATAPOINT_REFERENCE,
                     targetQualifier: 'Comments'
                 }
                ]
  @UI: { lineItem: [{ position: 10, label: 'Batch Number' }  ],
         selectionField: [{ position: 10 }]}
  @Search.fuzzinessThreshold: 0.8
  Batch_Id;

  @UI: {
  lineItem: [{ position: 20, label: 'Place' }],
               identification: [{ position: 20, label: 'Place' }],
               fieldGroup: [{ position: 10, qualifier: 'FG1', label: 'Place'  }]
  }
  @UI.dataPoint:{ title: 'Place' }
  Place;

  @UI: { lineItem: [{ position: 30, label: 'From date' }],
       identification: [{ position: 30, label: 'From date' }],
       fieldGroup: [{ position: 20, qualifier: 'FG1', label: 'From date'  }] }
  From_date;

  @UI: { lineItem: [{ position: 40, label: 'To date' }],
       identification: [{ position: 40, label: 'To date' }],
       fieldGroup: [{ position: 30, qualifier: 'FG1', label: 'To date'  }] }
  To_date;

  @UI: { lineItem: [{ position: 50, label: 'Expenditures' }],
       identification: [{ position: 50, label: 'Expenditures' }],
       fieldGroup: [{ position: 10, qualifier: 'FG2', label: 'Expenditures'  }] }
  Expend;

  @UI: { lineItem: [{ position: 60, label: 'Currency' }],
       identification: [{ position: 60, label: 'Currency' }],
       fieldGroup: [{ position: 20, qualifier: 'FG2', label: 'Currency' }] }
  @Consumption.valueHelpDefinition: [{ entity:{ name: 'I_Currency', element: 'Currency' } }]
  Currency;

  @UI: { lineItem: [{ position: 70, label: 'Total persons' }],
       identification: [{ position: 70, label: 'Total persons' }],
       fieldGroup: [{ position: 10, qualifier: 'FG3', label: 'Total persons' }] }
  TotalPax1;

  @UI:{ lineItem: [{  position: 80, label: 'Comments', importance: #HIGH },
                { type:#FOR_ACTION, dataAction: 'YetToConfirm',label: 'Yet to Confirm' },
                { type:#FOR_ACTION, dataAction: 'Confirmed',label: 'Confirm' },
                { type: #FOR_ACTION, dataAction: 'SendMail', label: 'Send Mail' },
                { criticality: 'Status_msg', criticalityRepresentation: #WITH_ICON  }

  ] }
  @UI.dataPoint:{ title: 'Status', criticality: 'Status_msg',criticalityRepresentation: #WITH_ICON }
  Comments;

  @UI: { lineItem: [{ position: 90, label: 'Send WhatsApp', type: #WITH_URL, url: 'WhatsApp' }],
       identification: [{ position: 90, label: 'WhatsApp', type: #WITH_URL, url: 'WhatsApp' }],
       fieldGroup: [{ position: 20, qualifier: 'FG3', label: 'WhatsApp' }] }
  Send_txt;

  @UI.hidden: true
  @UI: {
         identification: [{ position: 90, label: 'Status' }] }
  @UI.dataPoint:{ title: 'Status', criticality: 'Status_msg' }
  Status_msg;

  @UI.hidden: true
  Status;


}